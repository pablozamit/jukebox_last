# =======================================================
# CONFIGURACION DEL PUENTE JUKEBOX (Python Bridge)
# =======================================================
# Copia este archivo a .env y rellena los valores con los de tu bar.
#
#   copy .env.example .env   (en Windows)
#
# NUNCA subas el .env real a git - ya esta excluido por .gitignore
# =======================================================

# IP y puerto de Kodi (por defecto, localhost)
# El puerto 9090 es el WebSocket de Kodi (no confundir con el 8080 HTTP)
KODI_IP=127.0.0.1
KODI_PORT=9090

# Usuario y contrasena de Kodi
# (Configurados en Ajustes > Servicios > Control)
KODI_USER=kodi
KODI_PASS=kodi

# Ruta a la carpeta de videos (usa / no \)
VIDEO_FOLDER_PATH=D:/Pon/Aqui/La/Ruta/A/Tus/Videos

# Ruta al archivo de credenciales de Firebase (relativa al script)
FIREBASE_CREDENTIALS_JSON=./serviceAccountKey.json
