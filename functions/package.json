{
  "name": "catrina-social-functions",
  "private": true,
  "type": "module",
  "main": "src/index.mjs",
  "engines": { "node": "22" },
  "scripts": {
    "prepare:shared": "node scripts/prepare-shared.mjs",
    "pretest": "npm run prepare:shared",
    "test": "node --test test/*.test.mjs",
    "seed:catalog": "npm run prepare:shared && node scripts/seed-catalog.mjs",
    "seed:local": "npm run prepare:shared && node scripts/seed-local.mjs",
    "test:callable": "npm run prepare:shared && node test/callable-smoke.mjs",
    "test:emulators": "npm run prepare:shared && firebase emulators:exec --project demo-catrina-social --config ../firebase.local.json --only auth,firestore,functions \"node test/emulators.mjs\""
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.4.0"
  }
}
